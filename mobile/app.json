{
  "expo": {
    "name": "GreenPath",
    "slug": "greenpath-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "greenpath",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e7c3f"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0e7c3f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "social.greenpathorg.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow GreenPath to access your camera to take waste collection photos.",
        "NSMicrophoneUsageDescription": "Allow GreenPath to access your microphone to record voice notes and collector remarks.",
        "NSLocationWhenInUseUsageDescription": "Allow GreenPath to access your location to verify collection routes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e7c3f"
      },
      "package": "social.greenpathorg.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e7c3f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-camera",
      "expo-audio",
      "expo-sqlite"
    ]
  }
}
